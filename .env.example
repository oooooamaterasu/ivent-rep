# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyCSHWLKaAdUq87GMr4ZmfHiZM4IQRksnoU"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Required for Google OAuth authentication.
# Register a redirect URI such as http://localhost:3000/auth/callback for local development.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# LOCAL_AUTH: Use local development login instead of Google OAuth when enabled.
LOCAL_AUTH=true
